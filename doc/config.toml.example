external-endpoint = "localhost:6965"
internal-endpoint = "localhost:6967"
trillian-rpc-server = "localhost:6962"
url-prefix = ""
backend = "trillian"
trillian-tree-id-file = "/var/lib/sigsum-log/tree-id"
timeout = "10s"
key-file = ""
interval = "10s"
log-file = ""
log-level = "info"

[primary]
policy-file = ""
max-range = 10
rate-limit-file = ""
allow-test-domain = false
secondary-url = ""
secondary-pubkey-file = ""
sth-file = "/var/lib/sigsum-log/sth"

# Optional mTLS configuration in PEM format for HTTPS witness requests.
# Note: only supplied to witnesses that request mTLS in the TLS handshake.
# Note: if cert is a chain, keep it ordered with the leaf first in the file.
mtls-cert = ""
mtls-key = ""

[secondary]
primary-url = ""
